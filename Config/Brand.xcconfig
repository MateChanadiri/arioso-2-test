// ─────────────────────────────────────────────────────────────
//  BRAND CONFIG — the product name for Info.plist, the app name on the
//  Home Screen and every user-visible string (via Brand.name in Swift).
//  Change these lines, push to GitHub, run the workflow, done.
//  (Avoid double slashes in values: xcconfig treats them as comments.)
// ─────────────────────────────────────────────────────────────
BRAND_NAME = Arioso
BRAND_BUNDLE_ID = com.local.arioso
BRAND_TAGLINE = Music in your own voice
